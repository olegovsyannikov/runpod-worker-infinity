# Required: Hugging Face model IDs (semicolon-separated for multiple models)
MODEL_NAMES=BAAI/bge-small-en-v1.5

# Optional: Batch sizes per model (semicolon-separated, must match MODEL_NAMES count)
BATCH_SIZES=32

# Optional: Backend engine (torch, optimum, ctranslate2)
BACKEND=torch

# Optional: Data types per model (semicolon-separated: auto, fp16, fp8)
DTYPES=auto

# Optional: Port for the FastAPI server
PORT=80

# Optional: Infinity engine queue size
INFINITY_QUEUE_SIZE=48000

# Optional: Max concurrent requests (legacy parameter)
RUNPOD_MAX_CONCURRENCY=300

# Example with multiple models:
# MODEL_NAMES=BAAI/bge-small-en-v1.5;BAAI/bge-reranker-large
# BATCH_SIZES=32;16
# DTYPES=auto;auto
